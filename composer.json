{
    "name": "intellect-web-development/profile-sdk",
    "description": "HTTP-клиент универсального сервиса Profile",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "IWD\\ProfileSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IWD\\ProfileSdk\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.3",
        "symfony/http-client": "^7.1 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    }
}
